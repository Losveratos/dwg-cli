{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datenwg.de/schemas/mockup-spec/v3.json",
  "title": "MockupKitchen byDatenWG - mockup-spec.json (specVersion 3)",
  "description": "Pruefschema fuer die Spec aus assets/mockup/export.js. Geprueft wird die auf v3 gehobene Fassung: mockup_to_pbir.py hebt specVersion 1 und 2 intern auf diese Form, bevor validiert wird. Absichtlich permissiv gegenueber zusaetzlichen Schluesseln (das Tool darf wachsen), streng bei Typen, Enums und Pflichtfeldern.",
  "type": "object",
  "required": [
    "meta",
    "canvas",
    "zones",
    "pages"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "specVersion",
        "name"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "specVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "sourceSpecVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "specHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "de",
            "en"
          ]
        },
        "exportedAt": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataDate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "uiScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "pixel": {
          "description": "Rastermodus (assets/mockup/pixelgrid.js, KONZEPT-PIXELRASTER.md): Spaltenschritt, Zeilenschritt, Zwischenraum und Ränder in px. Fehlt der Block, gilt die bisherige Verteilung.",
          "type": "object",
          "properties": {
            "mode": { "const": "lattice" },
            "n": { "type": "integer", "minimum": 1 },
            "pitchX": { "type": "number" },
            "pitchY": { "type": "number" },
            "gutter": { "type": "integer", "minimum": 0 },
            "margins": { "type": "object", "properties": { "l": { "type": "integer" }, "r": { "type": "integer" }, "t": { "type": "integer" }, "b": { "type": "integer" } } },
            "exact": { "type": "boolean" }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "margin": {
          "type": "integer",
          "minimum": 0
        },
        "gutter": {
          "type": "integer",
          "minimum": 0
        },
        "tilePadding": {
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "type": "object"
        }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "cornerRadius": {
          "type": "integer",
          "minimum": 0
        },
        "tileStyle": {
          "enum": [
            "border",
            "shadow",
            "flat"
          ]
        },
        "pageBackground": {
          "$ref": "#/$defs/hex"
        },
        "tileBackground": {
          "$ref": "#/$defs/hex"
        },
        "headerStyle": {
          "enum": [
            "light",
            "dark",
            "accent",
            "custom"
          ]
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "darkMode": {
          "type": "boolean"
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "variancePalette": {
          "enum": [
            "teal",
            "ibcs"
          ]
        },
        "varianceColors": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "good": {
              "$ref": "#/$defs/hex"
            },
            "bad": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "colors": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "pageBackground": {
              "$ref": "#/$defs/hex"
            },
            "tileBackground": {
              "$ref": "#/$defs/hex"
            },
            "ink": {
              "$ref": "#/$defs/hex"
            },
            "headerBackground": {
              "$ref": "#/$defs/hex"
            },
            "headerInk": {
              "$ref": "#/$defs/hex"
            },
            "panel": {
              "$ref": "#/$defs/hex",
              "description": "optional: Filterbereich-Flaeche (Kitchen #ECEBE5)"
            },
            "rule": {
              "$ref": "#/$defs/hex",
              "description": "optional: Linien: helles Kopfband, Filterbereich, Fussleiste (#E3E1D8)"
            },
            "tileBorder": {
              "$ref": "#/$defs/hex",
              "description": "optional: Kachelrahmen (#E1DFD6)"
            },
            "muted": {
              "$ref": "#/$defs/hex",
              "description": "optional: gedaempfter Text (#6B7280)"
            },
            "slicerBorder": {
              "$ref": "#/$defs/hex",
              "description": "optional: Slicer-Kasten-Rahmen (#D9D6CC)"
            },
            "slicerBackground": {
              "$ref": "#/$defs/hex",
              "description": "optional: Slicer-Kasten (#FFFFFF)"
            },
            "slicerInk": {
              "$ref": "#/$defs/hex",
              "description": "optional: Slicer-Schrift (#374151)"
            },
            "footerNavInk": {
              "$ref": "#/$defs/hex",
              "description": "optional: Fussleisten-Nav (#475569)"
            },
            "footerBackground": {
              "$ref": "#/$defs/hex",
              "description": "optional: Fussleisten-Band (sonst Seitenhintergrund)"
            }
          }
        },
        "typography": {
          "$ref": "#/$defs/typography"
        },
        "nativePalette": {
          "description": "Ab Tool 0.4.7. Farbschema der Skizzen fuer native Visuals: neutral | pbi | kitchen (nur Skizze; im Bericht regelt das Theme die Datenfarben).",
          "enum": [
            "neutral",
            "pbi",
            "kitchen"
          ]
        },
        "sourceReport": {
          "description": "Optional (Konverter 0.6, Befund B2 Demo-Test 02.10.2026, nur ohne Live-Helfer: das Kitchen setzt es nicht, der Live-Runner liest es nicht): true, wenn die Gestaltung beim Einlesen aus dem Bericht uebernommen und seitdem nicht bewusst geaendert wurde. Dann keine Schritte fuer Seitenhintergrund (Seiten mit pbir.page) und Kachelstil (Kacheln mit pbir.visual: Flaeche, Rahmen, Schatten). Neue Seiten und Kacheln bekommen die Gestaltung wie bisher. Fehlt der Schluessel, aendert sich nichts (auch nicht am Spec-Hash).",
          "type": "boolean"
        }
      }
    },
    "zones": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/zone"
        },
        "nav": {
          "$ref": "#/$defs/navZone"
        },
        "header": {
          "$ref": "#/$defs/headerZone"
        },
        "filter": {
          "$ref": "#/$defs/filterZone"
        },
        "footer": {
          "$ref": "#/$defs/footerZone"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usedFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "newFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/newField"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "zone": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer",
          "minimum": 0
        },
        "h": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "navZone": {
      "allOf": [
        {
          "$ref": "#/$defs/zone"
        }
      ],
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "headerZone": {
      "allOf": [
        {
          "$ref": "#/$defs/zone"
        }
      ],
      "properties": {
        "style": {
          "enum": [
            "light",
            "dark",
            "accent",
            "custom"
          ]
        },
        "logoPos": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "nav": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "navOn": {
          "type": "boolean"
        },
        "navPosition": {
          "$ref": "#/$defs/navPosition"
        },
        "navAuto": {
          "type": "boolean"
        },
        "burger": {
          "type": "boolean"
        }
      }
    },
    "filterZone": {
      "allOf": [
        {
          "$ref": "#/$defs/zone"
        }
      ],
      "properties": {
        "mode": {
          "enum": [
            "right",
            "left",
            "top",
            "burger"
          ]
        },
        "side": {
          "type": "string"
        },
        "collapsible": {
          "type": "boolean"
        },
        "heading": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ab Tool 0.4.4. Sichtbare Ueberschrift des Filterbereichs; null = keine Ueberschrift. Fehlt der Schluessel (aeltere Specs), baut der Skill wie bisher die Ueberschrift \"Filter\"."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ab Tool 0.4.4. Freier Hinweistext im Filterbereich (unter der Ueberschrift, in der Leiste oben daneben); null = keiner."
        },
        "overlay": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "slicers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slicer"
          }
        },
        "bookmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "showsPanel": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "footerZone": {
      "allOf": [
        {
          "$ref": "#/$defs/zone"
        }
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "nav": {
          "description": "Ab Tool 0.4.3. Seitennamen der Navigation, wenn navPosition \"footer\" ist; sonst leer.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "navPosition": {
          "$ref": "#/$defs/navPosition"
        }
      }
    },
    "navPosition": {
      "description": "Ab Tool 0.4.3. Wo die Seitennavigation sitzt. `zones.header.navOn` ist die Kurzform fuer navPosition == \"header\".",
      "enum": [
        "header",
        "footer",
        "off"
      ]
    },
    "typography": {
      "type": [
        "object",
        "null"
      ],
      "description": "Ab Tool 0.4.3. Basisgroessen in px bei 1280 px Seitenbreite; die Seite skaliert mit k = canvas.width / 1280 (= design.fontScale). Wirksam: Titel = title x scale x k, Untertitel = sub x scale x k, Diagrammbeschriftung = chart x scale x k; im Bericht in pt = px x 0,75.",
      "properties": {
        "basis": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "title": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 96
        },
        "sub": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 96
        },
        "chart": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 96
        }
      }
    },
    "visualTypography": {
      "type": [
        "object",
        "null"
      ],
      "description": "Ab Tool 0.4.3. Kachel-Override: `scale` multipliziert die globale Typografie fuer diese Kachel; null = wie global.",
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        }
      }
    },
    "interaction": {
      "type": [
        "object",
        "null"
      ],
      "description": "Ab Tool 0.4.2. Verhalten der Kachel.",
      "properties": {
        "drillDown": {
          "type": "boolean"
        },
        "crossFilter": {
          "type": "boolean"
        },
        "drillThrough": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "slicer": {
      "type": "object",
      "required": [
        "table",
        "name",
        "ref"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "column",
            "measure"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^[^.]+\\..+$"
        },
        "isNew": {
          "type": "boolean"
        },
        "missing": {
          "type": "boolean",
          "description": "Seit Tool-Review 2026-09-25. true = das Feld fehlt im geladenen Modell und ist auch nicht als neues Feld vorgemerkt (Issue FIELD_NOT_IN_MODEL). Fehlt der Schluessel, ist das Feld bekannt."
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "type": {
          "description": "Ab Tool 0.4.4. Slicer-Art; fehlt sie (aeltere Specs), bleibt der Slicer wie pbir ihn anlegt.",
          "enum": [
            "dropdown",
            "list",
            "tile",
            "between",
            "date",
            "search",
            "relative",
            "button"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "name",
        "visuals"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Optional (Tool 0.6.1): Rolle der Seite. nav = steht in der Seitennavigation (Standard), detail = Detailseite, drill = Drillthrough-Ziel. detail und drill sind in Power BI ausgeblendet (visibility HiddenInViewMode).",
          "enum": ["nav", "detail", "drill"]
        },
        "hidden": {
          "description": "Optional (Tool 0.6.1): true, wenn die Seite in Power BI ausgeblendet ist (folgt aus role).",
          "type": "boolean"
        },
        "pbir": {
          "description": "Optional (Tool 0.6, mockup-live/CONTRACT.md): Seite wurde aus dem Projekt eingelesen. page = Ordnername der Seite in <Name>.Report/definition/pages. Der Runner aktualisiert diese Seite, statt eine neue anzulegen.",
          "type": "object",
          "required": [
            "page"
          ],
          "properties": {
            "page": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contentRect": {
          "$ref": "#/$defs/zone"
        },
        "visuals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual"
          }
        },
        "layoutTree": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "engine",
        "rect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pbir": {
          "description": "Optional (Tool 0.6, mockup-live/CONTRACT.md): Kachel stammt aus dem Projekt. page/visual = Ordnernamen von Seite und Visual. Mit pbir wird das Visual per Delta aktualisiert (Position, Größe, Bindung, Titel), nie neu angelegt; ohne pbir ist es neu.",
          "type": "object",
          "required": [
            "page",
            "visual"
          ],
          "properties": {
            "page": {
              "type": "string",
              "minLength": 1
            },
            "visual": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "stableId": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "kind": {
          "description": "Katalog-Typ aus assets/mockup/catalog.js. Die Gruppe `native` (ncolumn, nbar, nline, ndonut) kam mit Tool 0.4.1 dazu.",
          "enum": [
            "columns",
            "kombi",
            "colline",
            "absvar",
            "relvar",
            "bars",
            "barskombi",
            "bullet",
            "tornado",
            "dotplot",
            "pareto",
            "stackcol",
            "stackbar",
            "marimekko",
            "line",
            "varint",
            "slope",
            "fan",
            "zchart",
            "multiples",
            "area",
            "waterfall",
            "wfint",
            "wfkombi",
            "bridge",
            "tree",
            "heatmap",
            "scatter",
            "boxplot",
            "gantt",
            "kpi",
            "card",
            "multirow",
            "table",
            "pnl",
            "sparktable",
            "matrix",
            "gauge",
            "ncolumn",
            "nbar",
            "nline",
            "ndonut",
            "pie",
            "treemap",
            "decomp",
            "map",
            "deneb",
            "slicer",
            "text",
            "image",
            "button"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "enum": [
            "native",
            "ck",
            "deneb",
            "custom"
          ]
        },
        "chartKitchenType": {
          "type": [
            "string",
            "null"
          ]
        },
        "chartKitchenMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "native": {
          "$ref": "#/$defs/native"
        },
        "customVisual": {
          "$ref": "#/$defs/customVisual"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ab Kitchen 0.5.5 der sichtbare Kachelkopf, \"\" ohne Kopf (vorher Titel oder Katalog-Label). Container-Titel nur, wenn nicht leer."
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        },
        "workshop": {
          "$ref": "#/$defs/workshop"
        },
        "typography": {
          "$ref": "#/$defs/visualTypography"
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        },
        "samples": {
          "description": "Ab Tool 0.4.7. Beispielwerte aus dem Workshop (nur Anschauung fuer Skizze und Doku, keine Daten fuer den Bericht).",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "refValues": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "cell": {
          "description": "Nur im Rastermodus: Lage der Kachel als Brüche [Zähler, Nenner] im Pitch-Raum, x = [Anfang, Ende], y = [Anfang, Ende].",
          "type": "object",
          "properties": {
            "x": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
