			        LASTNONBLANK ( 'Kalender'[Datum], CALCULATE ( SUM ( 'Liquiditaet'[PY] ) ) )
			    )
		formatString: #,##0
		displayFolder: 08 Liquidität
		lineageTag: 2dcd5c70-b71f-5351-9143-9ec38dab7d61

	/// Plan je Liquiditätsart: Flüsse des Monats mit Vorzeichen als Summe, Kasse und Bank als Stand am Ende des letzten Monats mit Wert im Filterkontext (semi-additiv, auch über mehrere Jahre richtig).
