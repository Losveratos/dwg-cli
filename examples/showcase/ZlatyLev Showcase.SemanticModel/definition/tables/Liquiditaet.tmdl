table Liquiditaet
	lineageTag: ffb102c7-317f-5b54-a3b8-b543d9cc557f
	sourceLineageTag: [dbo].[liquiditaet]

	/// Ist je Liquiditätsart: Flüsse des Monats mit Vorzeichen als Summe, Kasse und Bank als Stand am Ende des letzten Monats mit Wert im Filterkontext (semi-additiv, auch über mehrere Jahre richtig).
	measure 'Liquidität AC' =
			CALCULATE ( SUM ( 'Liquiditaet'[AC] ), KEEPFILTERS ( 'Liquiditaetsart'[Fluss] <> "stock" ) )
			    + CALCULATE (
			        SUM ( 'Liquiditaet'[AC] ),
			        KEEPFILTERS ( 'Liquiditaetsart'[Fluss] = "stock" ),
			        LASTNONBLANK ( 'Kalender'[Datum], CALCULATE ( SUM ( 'Liquiditaet'[AC] ) ) )
			    )
		formatString: #,##0
		displayFolder: 08 Liquidität
		lineageTag: 37b4e604-7018-5be3-8283-9c2cd8f1ccdf

	/// Vorjahr je Liquiditätsart: Flüsse des Monats mit Vorzeichen als Summe, Kasse und Bank als Stand am Ende des letzten Monats mit Wert im Filterkontext (semi-additiv, auch über mehrere Jahre richtig).
	measure 'Liquidität PY' =
			CALCULATE ( SUM ( 'Liquiditaet'[PY] ), KEEPFILTERS ( 'Liquiditaetsart'[Fluss] <> "stock" ) )
			    + CALCULATE (
			        SUM ( 'Liquiditaet'[PY] ),
