			        LASTNONBLANK ( 'Kalender'[Datum], CALCULATE ( SUM ( 'Liquiditaet'[PL] ) ) )
			    )
		formatString: #,##0
		displayFolder: 08 Liquidität
		lineageTag: 8176afbd-8eee-5f17-b6f4-371e243dc283

	/// Forecast je Liquiditätsart: Flüsse des Monats mit Vorzeichen als Summe, Kasse und Bank als Stand am Ende des letzten Monats mit Wert im Filterkontext (semi-additiv, auch über mehrere Jahre richtig).
