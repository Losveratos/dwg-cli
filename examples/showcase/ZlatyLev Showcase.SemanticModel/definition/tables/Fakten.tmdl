table Fakten
	lineageTag: c17b451f-92a9-5731-ac11-8b5ebfa4b6cc
	sourceLineageTag: [dbo].[fakten]

	/// Ist je Konto, positiv wie gebucht. Vorzeichen über Konto[SignConvention], für das P&L-Visual.
	measure 'GuV AC' = SUM ( 'Fakten'[AC] )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: c3611dca-9377-47ed-a556-00ee99cd79eb

	/// Vorjahr je Konto, positiv wie gebucht. Vorzeichen über Konto[SignConvention], für das P&L-Visual.
	measure 'GuV PY' = SUM ( 'Fakten'[PY] )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: 98568877-1cb4-4f2f-afd6-b1a9e2075fcf

	/// Plan je Konto, positiv wie gebucht. Vorzeichen über Konto[SignConvention], für das P&L-Visual.
	measure 'GuV PL' = SUM ( 'Fakten'[PL] )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: dc94849d-01f1-4cf6-97d2-0aa59f6423fa

	/// Forecast je Konto, positiv wie gebucht. Vorzeichen über Konto[SignConvention], für das P&L-Visual.
	measure 'GuV FC' = SUM ( 'Fakten'[FC] )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: c761f523-8263-415f-afb7-64270cdc2d58

	/// Forecast Gesamtjahr der Auswahl, in jedem Monat gleich. Nur mit einem Jahr im Filter sinnvoll.
	measure 'GuV FC FY' = AVERAGEX ( VALUES ( 'Kalender'[Periode] ), CALCULATE ( SUM ( 'Fakten'[FC_FY] ) ) )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: d8f5624d-79c9-445f-82e2-3add7a435397

	/// Plan Gesamtjahr der Auswahl, in jedem Monat gleich. Nur mit einem Jahr im Filter sinnvoll.
	measure 'GuV PL FY' = AVERAGEX ( VALUES ( 'Kalender'[Periode] ), CALCULATE ( SUM ( 'Fakten'[PL_FY] ) ) )
		formatString: #,##0
		displayFolder: 01 GuV
		lineageTag: b7888496-bdb5-42a3-96c3-33b10633f518

	/// Ist mit Vorzeichen: Erlöse positiv, Aufwand negativ. Über alle Konten ergibt sich das EBIT.
	measure 'GuV ± AC' = SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV AC] * 'Konto'[SignConvention] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 GuV mit Vorzeichen
		lineageTag: a794ae87-5953-48c8-8b3c-283b02b0495a

	/// Vorjahr mit Vorzeichen: Erlöse positiv, Aufwand negativ. Über alle Konten ergibt sich das EBIT.
	measure 'GuV ± PY' = SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PY] * 'Konto'[SignConvention] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 GuV mit Vorzeichen
		lineageTag: fc6896d7-95fe-4dd7-a117-25ffa1575370

	/// Plan mit Vorzeichen: Erlöse positiv, Aufwand negativ. Über alle Konten ergibt sich das EBIT.
	measure 'GuV ± PL' = SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PL] * 'Konto'[SignConvention] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 GuV mit Vorzeichen
		lineageTag: 0fa5983c-0216-4ba3-a7cc-545f93971017

	/// Forecast mit Vorzeichen: Erlöse positiv, Aufwand negativ. Über alle Konten ergibt sich das EBIT.
	measure 'GuV ± FC' = SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV FC] * 'Konto'[SignConvention] )
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 GuV mit Vorzeichen
		lineageTag: 46f2e547-5ab1-4821-9a58-64504b88d459

	/// Nettoumsatz Ist: Bruttoumsatz minus Rabatte plus sonstige Erlöse.
	measure 'Umsatz AC' = CALCULATE ( [GuV ± AC], 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 68afdf85-8771-409b-aa6c-93d166e4ee28

	/// Nettoumsatz Vorjahr: Bruttoumsatz minus Rabatte plus sonstige Erlöse.
	measure 'Umsatz PY' = CALCULATE ( [GuV ± PY], 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: f18fe995-faf0-4b59-8531-354cc04fdb62

	/// Nettoumsatz Plan: Bruttoumsatz minus Rabatte plus sonstige Erlöse.
	measure 'Umsatz PL' = CALCULATE ( [GuV ± PL], 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 46ffc732-d793-406b-94bd-dc7af2dec453

	/// Nettoumsatz Forecast: Bruttoumsatz minus Rabatte plus sonstige Erlöse.
	measure 'Umsatz FC' = CALCULATE ( [GuV ± FC], 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 5b2522f6-e41b-421f-ae6c-9d5f3eb5626d

	/// Wareneinsatz Ist (Rohstoffe, Verpackung, Energie), positiv.
	measure 'Wareneinsatz AC' = CALCULATE ( [GuV AC], 'Konto'[L1] = "Wareneinsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: adfb8f06-4dce-41b4-a876-732385f20287

	/// Deckungsbeitrag Ist: Nettoumsatz minus Wareneinsatz.
	measure 'DB AC' = [Umsatz AC] - [Wareneinsatz AC]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: f80bb6bb-32aa-427d-8ede-a7eba30fb906

	/// Alle Kosten Ist (Wareneinsatz, Betriebskosten, Abschreibungen), positiv.
	measure 'Kosten AC' = CALCULATE ( [GuV AC], 'Konto'[Bereich] = "Kosten" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 954f0b79-cd68-4654-a21c-c94f74bc2397

	/// EBIT Ist: Summe aller Konten mit Vorzeichen.
	measure 'EBIT AC' = [GuV ± AC]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: f122ad2d-fee7-4368-bf32-6187762e56f1

	/// Deckungsbeitrag Ist im Verhältnis zum Nettoumsatz.
	measure 'DB-Marge % AC' = DIVIDE ( [DB AC], [Umsatz AC] )
		formatString: 0.0 %
		displayFolder: 03 Kennzahlen
		lineageTag: 1c11b820-a3a6-4250-9362-62fa9205d718

	/// Wareneinsatz Vorjahr (Rohstoffe, Verpackung, Energie), positiv.
	measure 'Wareneinsatz PY' = CALCULATE ( [GuV PY], 'Konto'[L1] = "Wareneinsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 0539973a-12d5-4460-a652-6b2782050071

	/// Deckungsbeitrag Vorjahr: Nettoumsatz minus Wareneinsatz.
	measure 'DB PY' = [Umsatz PY] - [Wareneinsatz PY]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 8ab5decf-cf3a-4002-85d1-418b9c2a1250

	/// Alle Kosten Vorjahr (Wareneinsatz, Betriebskosten, Abschreibungen), positiv.
	measure 'Kosten PY' = CALCULATE ( [GuV PY], 'Konto'[Bereich] = "Kosten" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 99b4ff89-d539-4a1f-a613-8b0f2652eb11

	/// EBIT Vorjahr: Summe aller Konten mit Vorzeichen.
	measure 'EBIT PY' = [GuV ± PY]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 702a6d17-843d-497b-b2f3-17c2279363b2

	/// Deckungsbeitrag Vorjahr im Verhältnis zum Nettoumsatz.
	measure 'DB-Marge % PY' = DIVIDE ( [DB PY], [Umsatz PY] )
		formatString: 0.0 %
		displayFolder: 03 Kennzahlen
		lineageTag: 94b4d953-3f48-4398-bb78-5ae928fa0b05

	/// Wareneinsatz Plan (Rohstoffe, Verpackung, Energie), positiv.
	measure 'Wareneinsatz PL' = CALCULATE ( [GuV PL], 'Konto'[L1] = "Wareneinsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 7f035a86-b5a2-4ec6-8f8b-5320b5a51935

	/// Deckungsbeitrag Plan: Nettoumsatz minus Wareneinsatz.
	measure 'DB PL' = [Umsatz PL] - [Wareneinsatz PL]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: f1bb2706-fffc-40f7-8170-ebdd1475eacf

	/// Alle Kosten Plan (Wareneinsatz, Betriebskosten, Abschreibungen), positiv.
	measure 'Kosten PL' = CALCULATE ( [GuV PL], 'Konto'[Bereich] = "Kosten" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 55d7686d-f01f-4a19-a15f-426c0e222bc6

	/// EBIT Plan: Summe aller Konten mit Vorzeichen.
	measure 'EBIT PL' = [GuV ± PL]
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 62429dfa-26d1-419d-a635-6a188695bdc9

	/// Deckungsbeitrag Plan im Verhältnis zum Nettoumsatz.
	measure 'DB-Marge % PL' = DIVIDE ( [DB PL], [Umsatz PL] )
		formatString: 0.0 %
		displayFolder: 03 Kennzahlen
		lineageTag: 8fe8d773-e9bb-4c20-838a-810b64231c36

	/// Absatz Ist in Hektoliter.
	measure 'Absatz hl AC' = SUM ( 'Fakten'[Hektoliter AC] )
		formatString: #,##0.0
		displayFolder: 03 Kennzahlen
		lineageTag: 931f68ee-eaa7-4e1e-b97b-15888e82946a

	/// Absatz Vorjahr in Hektoliter.
	measure 'Absatz hl PY' = SUM ( 'Fakten'[Hektoliter PY] )
		formatString: #,##0.0
		displayFolder: 03 Kennzahlen
		lineageTag: 7c85c814-8e3d-45e0-8ca4-27bc58a9f8a4

	/// Absatz Plan in Hektoliter.
	measure 'Absatz hl PL' = SUM ( 'Fakten'[Hektoliter PL] )
		formatString: #,##0.0
		displayFolder: 03 Kennzahlen
		lineageTag: f9fad2da-19fa-4bf0-a930-014304449c1f

	/// Absatz Forecast in Hektoliter.
	measure 'Absatz hl FC' = SUM ( 'Fakten'[Hektoliter FC] )
		formatString: #,##0.0
		displayFolder: 03 Kennzahlen
		lineageTag: 2fe0f68b-5bcf-4e53-93df-d5ef1504942d

	/// Nettoumsatz Ist je Hektoliter Absatz in EUR.
	measure 'Erlös je hl AC' = DIVIDE ( [Umsatz AC], [Absatz hl AC] )
		formatString: #,##0.00
		displayFolder: 03 Kennzahlen
		lineageTag: 2b924cab-719b-4a77-b70d-9088ced720eb

	/// Nettoumsatz Vorjahr je Hektoliter Absatz in EUR.
	measure 'Erlös je hl PY' = DIVIDE ( [Umsatz PY], [Absatz hl PY] )
		formatString: #,##0.00
		displayFolder: 03 Kennzahlen
		lineageTag: 8019faa2-58f7-4bdd-a840-dcfee15a47c1

	/// Nettoumsatz Plan je Hektoliter Absatz in EUR.
	measure 'Erlös je hl PL' = DIVIDE ( [Umsatz PL], [Absatz hl PL] )
		formatString: #,##0.00
		displayFolder: 03 Kennzahlen
		lineageTag: 3574e3af-f717-41b9-9c4b-fb66e560db2c

	/// Nettoumsatz Forecast Gesamtjahr, in jedem Monat gleich. Nur mit einem Jahr im Filter sinnvoll.
	measure 'Umsatz FC FY' = CALCULATE ( SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV FC FY] * 'Konto'[SignConvention] ), 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 3bf756fd-b90b-4dcf-b44b-ca3bd6102931

	/// Nettoumsatz Plan Gesamtjahr, in jedem Monat gleich. Nur mit einem Jahr im Filter sinnvoll.
	measure 'Umsatz PL FY' = CALCULATE ( SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PL FY] * 'Konto'[SignConvention] ), 'Konto'[L1] = "Nettoumsatz" )
		formatString: #,##0
		displayFolder: 03 Kennzahlen
		lineageTag: 077fa0b2-e1fd-42ca-a064-eb1a48c6aa02

	/// Vorjahr je Konto, positiv wie gebucht. Vorzeichen über Konto[SignConvention], für das P&L-Visual, nur Monate mit Ist (bis August 2026).
	measure 'GuV PY bis Ist' = CALCULATE ( [GuV PY], 'Kalender'[Ist] = TRUE () )
		formatString: #,##0
		displayFolder: 04 Bis Ist
		lineageTag: d222efaa-22fd-4443-8f99-b8b4adc6c5fa

