	partition 'Sales Demo' = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(File.Contents(DemoPfad & "sales-fact.csv"), [Delimiter = ";", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Header = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(Header, {{"Date", type date}, {"Scenario", type text}, {"Product", type text}, {"Category", type text}, {"Country", type text}, {"Region", type text}}, "en-US"),
				    Entpivotiert = Table.UnpivotOtherColumns(Typen, {"Region", "Country", "Category", "Product", "Scenario", "Date"}, "Attribut", "Wert"),
				    Umbenannt = Table.RenameColumns(Entpivotiert, {{"Attribut", "KPI"}, {"Wert", "Value"}}),
				    Wertetyp = Table.TransformColumnTypes(Umbenannt, {{"Value", type number}}, "en-US")
				in
				    Wertetyp

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

