table 'Sales Demo'
	lineageTag: 497201f0-fe76-4d2d-8d2a-0b54b4d5e960

	measure AC = ```
			var _base = CALCULATE (SUM('Sales Demo'[Value]),'Sales Demo'[Scenario]="AC")
			     var _select = SELECTEDVALUE('Sales Demo'[KPI])
			     var _result = IF(ISBLANK(_select),CALCULATE(_base,'Sales Demo'[KPI]="Revenue"),_base)
			     RETURN _result
			   
			```
		formatString: 0
		displayFolder: _KPI
		lineageTag: ff414a4e-423d-4d7e-9fdb-19aa5bc2a843

	measure FC = ```
			
			 CALCULATE(SUM('Sales Demo'[Value]),KEEPFILTERS('Sales Demo'[Scenario]="FC1"))
			   
			```
		formatString: 0
		displayFolder: _KPI
		lineageTag: 1e94367c-114a-4588-9cc3-5fcdc7115a94

	measure PY = CALCULATE([AC],DATEADD(Calender[Date],-1,YEAR))
		formatString: 0
		displayFolder: _KPI
		lineageTag: f7028b30-8684-4225-8997-6e6a85b0f499

	measure PL = CALCULATE(SUM('Sales Demo'[Value]),'Sales Demo'[Scenario]="PL1")
		formatString: 0
		displayFolder: _KPI
		lineageTag: 3557390a-b836-4950-924b-32ef17a07a4f

	measure 'AC YTD' = TOTALYTD([AC],Calender[Date])
		formatString: 0
		displayFolder: _KPI
		lineageTag: 21765406-a88b-4b40-ac6c-5e99bed058d5

	measure 'PY YTD' = TOTALYTD([PY],Calender[Date],Calender[Month]<8)
		formatString: 0
		displayFolder: _KPI
		lineageTag: a0375ff0-c637-40fb-afad-3b7f498f68d4

	measure 'PL YTD' = TOTALYTD([PL],Calender[Date],Calender[Month]<8)
		displayFolder: _KPI
		lineageTag: 7fac8450-c6b3-4437-8d96-6196646375d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DatenWG = DatenWG()
		displayFolder: _KPI
		lineageTag: 7a565e87-e432-4f37-8744-100774635b09

	measure FC2 = ```
			
			 CALCULATE(SUM('Sales Demo'[Value]),KEEPFILTERS('Sales Demo'[Scenario]="FC2"))
			   
			```
		formatString: 0
		displayFolder: _KPI
		lineageTag: a7b3f5c8-a9c1-4047-9652-be4039f4bdbd

	measure FC3 = CALCULATE ( SUM ( 'Sales Demo'[Value] ), KEEPFILTERS ( 'Sales Demo'[Scenario] = "FC3" ) )
		formatString: 0
		displayFolder: _KPI
		lineageTag: 3557390a-b836-4950-924b-32ef1000f003

	measure PL2 = CALCULATE ( SUM ( 'Sales Demo'[Value] ), KEEPFILTERS ( 'Sales Demo'[Scenario] = "PL2" ) )
		formatString: 0
		displayFolder: _KPI
		lineageTag: 3557390a-b836-4950-924b-32ef1000f004

	measure 'Δ PY' = [AC] - [PY]
		formatString: +#,##0;-#,##0;0
		displayFolder: _Abweichungen
		lineageTag: 3557390a-b836-4950-924b-32ef1000f005

	measure 'Δ PY %' = DIVIDE ( [Δ PY], ABS ( [PY] ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: _Abweichungen
		lineageTag: 3557390a-b836-4950-924b-32ef1000f006

	measure 'Δ PL' = [AC] - [PL]
		formatString: +#,##0;-#,##0;0
		displayFolder: _Abweichungen
		lineageTag: 3557390a-b836-4950-924b-32ef1000f007

	measure 'Δ PL %' = DIVIDE ( [Δ PL], ABS ( [PL] ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: _Abweichungen
		lineageTag: 3557390a-b836-4950-924b-32ef1000f008

	measure 'Δ FC' = [FC] - [PL]
		formatString: +#,##0;-#,##0;0
		displayFolder: _Abweichungen
		lineageTag: 3557390a-b836-4950-924b-32ef1000f009

	/// Rollierende 12 Monate Ist — glättet Saisonalität, zeigt den echten Trend.
	measure 'AC R12' =
			CALCULATE (
			    [AC],
			    DATESINPERIOD ( Calender[Date], MAX ( Calender[Date] ), -12, MONTH )
			)
		formatString: #,##0
		displayFolder: _Trend
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00a

	/// Vormonat Ist
	measure 'AC PM' = CALCULATE ( [AC], DATEADD ( Calender[Date], -1, MONTH ) )
		formatString: #,##0
		displayFolder: _Trend
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00b

	measure Umsatz = CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Revenue", 'Sales Demo'[Scenario] = "AC" )
		formatString: #,##0
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00c

	measure Kosten = CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Cost", 'Sales Demo'[Scenario] = "AC" )
		formatString: #,##0
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00d

	measure Ergebnis = CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Profit", 'Sales Demo'[Scenario] = "AC" )
		formatString: #,##0
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00e

	measure 'Marge %' = DIVIDE ( [Ergebnis], [Umsatz] )
		formatString: 0.0 %
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f00f

	measure Menge = CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Units Sold", 'Sales Demo'[Scenario] = "AC" )
		formatString: #,##0
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f010

	measure 'Ø Preis' = DIVIDE ( [Umsatz], [Menge] )
		formatString: #,##0.00
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f011

	measure 'Retourenquote %' =
			DIVIDE (
			    CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Returned Units", 'Sales Demo'[Scenario] = "AC" ),
			    [Menge]
			)
		formatString: 0.0 %
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f012

	measure 'Marketingquote %' =
			DIVIDE (
			    CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[KPI] = "Marketing Spend", 'Sales Demo'[Scenario] = "AC" ),
			    [Umsatz]
			)
		formatString: 0.0 %
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f013

	measure CSAT =
			CALCULATE (
			    AVERAGE ( 'Sales Demo'[Value] ),
			    'Sales Demo'[KPI] = "Customer Satisfaction",
			    'Sales Demo'[Scenario] = "AC"
			)
		formatString: 0.0
		displayFolder: _Geschäft
		lineageTag: 3557390a-b836-4950-924b-32ef1000f014

