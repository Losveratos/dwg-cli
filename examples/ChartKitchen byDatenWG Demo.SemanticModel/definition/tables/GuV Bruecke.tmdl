table 'GuV Bruecke'
	lineageTag: c367b366-0550-4cf9-bbd8-4fc9e91068d8

	calculationGroup
		precedence: 20

		calculationItem Revenue = CALCULATE( SELECTEDMEASURE(), 'Sales Demo'[KPI] = "Revenue" )

		calculationItem Cost = - CALCULATE( SELECTEDMEASURE(), 'Sales Demo'[KPI] = "Cost" )

		calculationItem Profit = CALCULATE( SELECTEDMEASURE(), 'Sales Demo'[KPI] = "Revenue" ) - CALCULATE( SELECTEDMEASURE(), 'Sales Demo'[KPI] = "Cost" )

	column Position
		dataType: string
