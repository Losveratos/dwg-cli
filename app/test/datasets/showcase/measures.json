{
  "Absatz hl AC": "SUM ( 'Fakten'[Hektoliter AC] )",
  "Absatz hl FC": "SUM ( 'Fakten'[Hektoliter FC] )",
  "Absatz hl PL": "SUM ( 'Fakten'[Hektoliter PL] )",
  "Absatz hl PL bis Ist": "CALCULATE ( [Absatz hl PL], 'Kalender'[Ist] = TRUE () )",
  "Absatz hl PY": "SUM ( 'Fakten'[Hektoliter PY] )",
  "Absatz hl PY bis Ist": "CALCULATE ( [Absatz hl PY], 'Kalender'[Ist] = TRUE () )",
  "DB AC": "[Umsatz AC] - [Wareneinsatz AC]",
  "DB PL": "[Umsatz PL] - [Wareneinsatz PL]",
  "DB PL bis Ist": "CALCULATE ( [DB PL], 'Kalender'[Ist] = TRUE () )",
  "DB PY": "[Umsatz PY] - [Wareneinsatz PY]",
  "DB PY bis Ist": "CALCULATE ( [DB PY], 'Kalender'[Ist] = TRUE () )",
  "DB-Marge % AC": "DIVIDE ( [DB AC], [Umsatz AC] )",
  "DB-Marge % PL": "DIVIDE ( [DB PL], [Umsatz PL] )",
  "DB-Marge % PY": "DIVIDE ( [DB PY], [Umsatz PY] )",
  "EBIT AC": "[GuV ± AC]",
  "EBIT PL": "[GuV ± PL]",
  "EBIT PL bis Ist": "CALCULATE ( [EBIT PL], 'Kalender'[Ist] = TRUE () )",
  "EBIT PY": "[GuV ± PY]",
  "EBIT PY bis Ist": "CALCULATE ( [EBIT PY], 'Kalender'[Ist] = TRUE () )",
  "Erlös je hl AC": "DIVIDE ( [Umsatz AC], [Absatz hl AC] )",
  "Erlös je hl PL": "DIVIDE ( [Umsatz PL], [Absatz hl PL] )",
  "Erlös je hl PY": "DIVIDE ( [Umsatz PY], [Absatz hl PY] )",
  "GuV AC": "SUM ( 'Fakten'[AC] )",
  "GuV FC": "SUM ( 'Fakten'[FC] )",
  "GuV FC FY": "AVERAGEX ( VALUES ( 'Kalender'[Periode] ), CALCULATE ( SUM ( 'Fakten'[FC_FY] ) ) )",
  "GuV PL": "SUM ( 'Fakten'[PL] )",
  "GuV PL FY": "AVERAGEX ( VALUES ( 'Kalender'[Periode] ), CALCULATE ( SUM ( 'Fakten'[PL_FY] ) ) )",
  "GuV PL bis Ist": "CALCULATE ( [GuV PL], 'Kalender'[Ist] = TRUE () )",
  "GuV PY": "SUM ( 'Fakten'[PY] )",
  "GuV PY bis Ist": "CALCULATE ( [GuV PY], 'Kalender'[Ist] = TRUE () )",
  "GuV ± AC": "SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV AC] * 'Konto'[SignConvention] )",
  "GuV ± FC": "SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV FC] * 'Konto'[SignConvention] )",
  "GuV ± PL": "SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PL] * 'Konto'[SignConvention] )",
  "GuV ± PY": "SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PY] * 'Konto'[SignConvention] )",
  "Kosten AC": "CALCULATE ( [GuV AC], 'Konto'[Bereich] = \"Kosten\" )",
  "Kosten PL": "CALCULATE ( [GuV PL], 'Konto'[Bereich] = \"Kosten\" )",
  "Kosten PL bis Ist": "CALCULATE ( [Kosten PL], 'Kalender'[Ist] = TRUE () )",
  "Kosten PY": "CALCULATE ( [GuV PY], 'Konto'[Bereich] = \"Kosten\" )",
  "Kosten PY bis Ist": "CALCULATE ( [Kosten PY], 'Kalender'[Ist] = TRUE () )",
  "Umsatz AC": "CALCULATE ( [GuV ± AC], 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz FC": "CALCULATE ( [GuV ± FC], 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz FC FY": "CALCULATE ( SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV FC FY] * 'Konto'[SignConvention] ), 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz PL": "CALCULATE ( [GuV ± PL], 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz PL FY": "CALCULATE ( SUMX ( VALUES ( 'Konto'[SignConvention] ), [GuV PL FY] * 'Konto'[SignConvention] ), 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz PL bis Ist": "CALCULATE ( [Umsatz PL], 'Kalender'[Ist] = TRUE () )",
  "Umsatz PY": "CALCULATE ( [GuV ± PY], 'Konto'[L1] = \"Nettoumsatz\" )",
  "Umsatz PY bis Ist": "CALCULATE ( [Umsatz PY], 'Kalender'[Ist] = TRUE () )",
  "Wareneinsatz AC": "CALCULATE ( [GuV AC], 'Konto'[L1] = \"Wareneinsatz\" )",
  "Wareneinsatz PL": "CALCULATE ( [GuV PL], 'Konto'[L1] = \"Wareneinsatz\" )",
  "Wareneinsatz PY": "CALCULATE ( [GuV PY], 'Konto'[L1] = \"Wareneinsatz\" )"
}
