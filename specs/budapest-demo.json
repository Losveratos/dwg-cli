{
  "name": "Budapest BI Forum demo",
  "about": "Demo for the Budapest BI Forum 2026: the first three pages of the Power BI report \"Budapest BI Forum\" (Custom Viz, Group P&L, Plan gap) as a Fabric App, with the original visuals ChartKitchen byDatenWG and P&L Statement byDatenWG on the semantic model \"Budapest BI Forum\". Slicers of the report become the collapsible filter panel; the P&L tile has a collapsible panel with live format options.",
  "lang": "en",
  "resolution": "fullhd",
  "visualHeaders": true,
  "footer": "Synthetic demo data. Presentation inspired by IBCS; IBCS® is a registered trademark of the IBCS Institute.",
  "slicers": [
    {
      "column": "'dim-datum'[Jahr]",
      "label": "Year",
      "default": [
        2026
      ],
      "multi": false
    },
    {
      "column": "'dim-region'[Region]",
      "label": "Region",
      "default": [],
      "multi": true
    },
    {
      "column": "'dim-gesellschaft'[Country]",
      "label": "Country",
      "default": [],
      "multi": true
    },
    {
      "column": "'dim-gesellschaft'[Währung]",
      "label": "Currency",
      "default": [],
      "multi": true
    },
    {
      "column": "'dim-gesellschaft'[Short name]",
      "label": "Company",
      "default": [],
      "multi": true,
      "sortBy": "'dim-gesellschaft'[Sortierung]"
    },
    {
      "column": "'close-status'[Close status]",
      "label": "Close status",
      "default": [],
      "multi": false,
      "sortBy": "'close-status'[Close status Sort]"
    }
  ],
  "pages": [
