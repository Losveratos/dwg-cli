            894
          ],
          "title": "Revenue vs plan and previous year by company",
          "bindings": {
            "category": "'dim-gesellschaft'[Short name]",
            "actual": "'_Measures'[Revenue AC]",
            "plan": "'_Measures'[Revenue PL]",
            "previousYear": "'_Measures'[Revenue PY]"
          },
          "sortBy": {
            "'dim-gesellschaft'[Short name]": "'dim-gesellschaft'[Sortierung]"
          },
          "displayNames": {
            "[actual]": "Revenue AC",
            "[previousYear]": "Revenue PY",
            "[plan]": "Revenue PL"
          },
          "objects": {
            "chart": {
              "template": "off",
              "templateApplied": "off",
              "orientation": "catbridge",
              "comparisonMode": "plan",
              "showAbsoluteVariance": true,
              "showRelativeVariance": true,
              "dualVariance": true,
              "waterfallStyle": false,
              "pyTriangle": true,
              "chartButtons": true,
              "chipMenu": false,
              "smartStart": false
            },
            "ibcsTitle": {
              "show": false,
              "kpi": "Revenue vs plan and previous year by company",
              "period": "January to October 2026"
            },
            "labels": {
              "fontPreset": "fullhd",
              "displayUnits": "m",
              "decimals": 1
            }
          }
        },
        {
          "id": "months",
          "visual": "chartkitchen",
          "rect": [
            1155,
            123,
            738,
            894
          ],
